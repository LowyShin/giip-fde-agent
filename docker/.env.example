# Copy to .env and fill in real values (never commit .env — see docker/README.md).

# ── repo ──
# REPO_URL=https://github.com/LowyShin/giip-fde-agent.git
# REPO_BRANCH=main

# ── csn/sk/login_id registration (docker/setup-registration.js) ──
GIIP_LOGIN_ID=
GIIP_SK=
GIIP_CSN=
# GIIP_PROJECT_NAME=docker
# GIIP_WORKDIR=            # defaults to the cloned giip-fde-agent repo itself
# GIIP_REST_BRANCH=        # only if this project's working branch != main/master
# GIIP_API_BASE=https://giipfaw.azurewebsites.net/api
# GIIP_FORCE_REGEN=false   # true = overwrite existing csn-projects.json/giip-accounts.json on every start

# ── slack-bot (optional — omit both to skip slack-bot entirely) ──
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# SLACK_CHANNEL_ID=        # optional per-channel csn/sk/login_id entry

# ── scheduler ──
# GIIP_ENABLE_SCHEDULER=true   # false = skip the hourly cron entirely
