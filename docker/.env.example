# Copy to .env and fill in real values (never commit .env — see docker/README.md).

# ── repo ──
# REPO_URL=https://github.com/LowyShin/giip-fde-agent.git
# REPO_BRANCH=main

# ── OPTION A (giip 2665): fetch everything below from GIIP web ──
# Create a Docker instance at GIIP web (admin > Docker Instances), paste the issued token here,
# and leave GIIP_LOGIN_ID/GIIP_SK/GIIP_CSN/SLACK_*/etc below blank — entrypoint.sh fetches them
# from GIIP at container start (docker/fetch-instance-env.sh). Values set below always win over
# what the token fetch returns (per-key override), so you can mix both.
# GIIP_INSTANCE_TOKEN=
# GIIP_INSTANCE_API_BASE=https://giipfaw.azurewebsites.net/api

# ── OPTION B: csn/sk/login_id registration by hand (docker/setup-registration.js) ──
GIIP_LOGIN_ID=
GIIP_SK=
GIIP_CSN=
# GIIP_PROJECT_NAME=docker
# GIIP_WORKDIR=            # defaults to the cloned giip-fde-agent repo itself, OR — when
#                          # GIIP_PROJECT_REPO_URL is set below and this is left blank — the
#                          # project repo clone path (/work/<repo>)
# GIIP_REST_BRANCH=        # only if this project's working branch != main/master
# ── target project repo (giip 2949): clone the repo the scheduler should work ──
# When set, entrypoint.sh clones this repo on first boot (no shell access / no manual CQE needed —
# just fill this in the GIIP web "Create Docker instance" form). If GIIP_WORKDIR is blank it clones
# to /work/<repo-name> and registers THAT path as the scheduler workdir; if GIIP_WORKDIR is set it
# clones there instead. A clone failure only warns — the container keeps running.
# GIIP_PROJECT_REPO_URL=      # e.g. https://github.com/owner/repo.git
# GIIP_PROJECT_REPO_BRANCH=   # defaults to main
# GIIP_API_BASE=https://giipfaw.azurewebsites.net/api
# GIIP_FORCE_REGEN=false   # true = overwrite existing csn-projects.json/giip-accounts.json on every start

# ── slack-bot (optional — omit both to skip slack-bot entirely) ──
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# SLACK_CHANNEL_ID=        # optional per-channel csn/sk/login_id entry

# ── scheduler ──
# GIIP_ENABLE_SCHEDULER=true   # false = skip the hourly cron entirely

# ── giip agent (optional — makes this container a live, checkable lssn in GIIP web) ──
# Without this, GIIP web has no way to tell whether the container is up right now (only a
# one-time "last fetched" timestamp from the token exchange). With it, giipAgentLinux polls
# every minute and this container shows up in GIIP's normal server list (lsvrlist/lsvrdetail)
# with a live heartbeat (tLSvr.lsChkdt), reusing the SAME GIIP_SK above — no separate credential.
# GIIP_ENABLE_AGENT=true   # false = skip it (needs GIIP_SK to be set either way)
# GIIP_AGENT_URL=https://github.com/LowyShin/giipAgentLinux.git
# GIIP_AGENT_DIR=/work/giipAgentLinux
# GIIP_LSSN=                # (optional) lssn to pre-assign. Normally left blank — when creating a
#                           # Docker instance at GIIP web (admin > Docker Instances), GIIP issues
#                           # an lssn together with SK and injects it via GIIP_INSTANCE_TOKEN or
#                           # GIIP_LSSN. If set to a positive integer, that value is written to
#                           # giipAgent.cnf directly. If blank/invalid/non-integer, lssn="0" is
#                           # used and giipAgent3.sh self-registers on first run (backward-compatible).
